<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- TargetFramework, Nullable, ImplicitUsings and the warning/audit settings come from
       Directory.Build.props (ADR-0013). -->
  <PropertyGroup>
    <RootNamespace>Api</RootNamespace>
    <UserSecretsId>0411e305-9bb7-467e-9b0c-758a39efc601</UserSecretsId>
  </PropertyGroup>

  <!--
    The project lives at the repository root (ADR-0018), so the SDK's default globs reach
    every subdirectory. Anything that is not application source must be excluded here or
    it gets compiled into the API.

    tests/**  — separate projects; without this exclusion their .cs files are compiled
                into this assembly as well, and the same type is then defined twice.
    Other directories hold no .cs today, but they are excluded so a stray file added
    later cannot silently become part of the API assembly.
  -->
  <PropertyGroup>
    <DefaultItemExcludes>
      $(DefaultItemExcludes);
      tests/**;
      Documentation/**;
      ROADMAP/**;
      http/**;
      .github/**;
      .git/**
    </DefaultItemExcludes>
  </PropertyGroup>

  <!-- Versions are declared centrally in Directory.Packages.props (ADR-0013).
       Do not add a Version attribute here — it is an error under CPM. -->
  <!-- The breached-password deny list ships inside the assembly, not as a loose file:
       a validator whose rules depend on a file that can go missing at deploy time fails
       open, and a password policy that fails open is not a policy. -->
  <ItemGroup>
    <EmbeddedResource Include="Validators/Common/CommonPasswords.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Isopoh.Cryptography.Argon2" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />

    <!-- Structured logging (ADR-0010, §15). Brings the console sink, the compact JSON
         formatter and Serilog.Settings.Configuration transitively — no separate reference
         for any of them, and no Serilog.Enrichers.Environment: the two properties it would
         add are set with Enrich.WithProperty instead, which needs no new package and
         therefore no new ADR. -->
    <PackageReference Include="Serilog.AspNetCore" />

    <!-- Design-time only: the migrations tooling. PrivateAssets keeps it out of the
         published output — a deployed API has no business carrying the scaffolder. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Integration tests drive the app through WebApplicationFactory, which needs to see
       the implicitly-generated Program class (§21). -->
  <ItemGroup>
    <InternalsVisibleTo Include="IntegrationTests" />
  </ItemGroup>

</Project>
