<Project>

  <!--
    Central Package Management — the single place every NuGet version is declared.
    Projects reference packages without a Version attribute; the version comes from here.

    Rules (ADR-0013):
      * No floating versions, no wildcards, no version ranges. Exact pins only.
      * Adding a package requires an ADR — see Documentation/Decisions/README.md.
      * Transitive pinning is ON, so a vulnerable transitive dependency can be forced
        to a patched version from this file without waiting for the parent package.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- ==================== API — web stack ==================== -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.16" />
    <PackageVersion Include="Asp.Versioning.Mvc" Version="10.0.0" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0" />
  </ItemGroup>

  <!-- ==================== API — persistence ==================== -->
  <ItemGroup>
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />

    <!--
      Version alignment, not a new dependency — both are already in the graph.
      Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 asks for EF Core 10.0.4; the Design
      package asks for 10.0.10. Inside the API project the higher version wins, but Design
      is PrivateAssets=all so it does not flow to the test projects, which then resolve
      10.0.4 against an API assembly compiled against 10.0.10 — MSB3277 on every test build.
      Pinning the runtime packages centrally gives every project one version.
      Revisit when the Npgsql provider ships against a 10.0.10-or-later EF Core.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <!-- ==================== API — authentication and cryptography ==================== -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.10" />
    <PackageVersion Include="AspNet.Security.OAuth.GitHub" Version="10.0.0" />
    <PackageVersion Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />
    <PackageVersion Include="Otp.NET" Version="1.4.1" />
    <PackageVersion Include="Fido2.AspNet" Version="4.0.1" />

    <!--
      Persists the Data Protection key ring to PostgreSQL (ADR-0021). Without it the ring
      is per-machine and, in a container with no writable home directory, per-process —
      which makes every stored signing key undecryptable after a restart.
      Pinned to the same 10.0.10 as every other Microsoft.AspNetCore.* and EF Core package.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.10" />
  </ItemGroup>

  <!-- ==================== API — validation, logging, caching ==================== -->
  <ItemGroup>
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.8.0" />
  </ItemGroup>

  <!-- ==================== API — observability and health ==================== -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
  </ItemGroup>

  <!-- ==================== Tests ==================== -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="coverlet.msbuild" Version="6.0.4" />
  </ItemGroup>

  <!--
    ==================== Transitive pins (security) ====================
    Entries below are NOT referenced directly by any project. They exist to force a
    patched version of a transitive dependency. Each must name the advisory it fixes,
    and each should be REMOVED once the parent package ships the fix itself.
  -->
  <ItemGroup>
    <!--
      GHSA-v5pm-xwqc-g5wc (high): circular schema references can terminate OpenAPI parsing.
      Vulnerable: >= 2.0.0-preview.11, <= 2.7.4. First patched: 2.7.5.
      Microsoft.AspNetCore.OpenApi 10.0.10 pulls 2.0.0 transitively, so it is pinned forward.
      Remove when Microsoft.AspNetCore.OpenApi references >= 2.7.5 on its own.

      STAY ON THE 2.x LINE. Do not "upgrade" this to 3.x.
      Microsoft.AspNetCore.OpenApi 10.0.10 declares a dependency on Microsoft.OpenApi 2.0.0
      and its XmlCommentGenerator source generator emits `IOpenApiMediaType.Example = ...`,
      which is settable in 2.x but READ-ONLY in 3.x. Pinning 3.x fails the build with
      CS0200 in OpenApiXmlCommentSupport.generated.cs (verified 2026-07-22).
      The 3.x line fixes the same advisory (patched 3.5.4), so there is no security
      reason to move; 2.11.0 clears it without the breaking change.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
  </ItemGroup>

</Project>
